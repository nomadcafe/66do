# Domain Financial - Domain Investment Tracker
# Environment Variables Configuration

# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Do NOT add SUPABASE_SERVICE_ROLE_KEY. API routes use the user's JWT with
# RLS (see src/lib/supabaseAuthClient.ts). A service-role key would silently
# bypass RLS and defeat the ownership checks.

# Upstash Redis (for magic-link + write rate limiting; see src/lib/rateLimit.ts)
# Get these from https://console.upstash.com -> create a Redis database ->
# "REST API" tab.
# - Local/dev: if unset, rate limiting fails open (sign-in still works).
# - Production: REQUIRED. Server boot will throw via instrumentation.ts and
#   rate-limited endpoints return 503 — protects against silent fail-open.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional: App Configuration
# 正式环境请设为 https://www.domain.financial（或你的正式域名）
NEXT_PUBLIC_APP_NAME=Domain Financial
NEXT_PUBLIC_APP_URL=http://localhost:3078
# Magic Link / Google OAuth 回调会用到，正式环境请与 NEXT_PUBLIC_APP_URL 一致（如 https://www.domain.financial）
# 亦为 SEO 规范域名：sitemap、robots、metadataBase（Open Graph 等）用此生成绝对 URL；请与对外主域名一致（www 或 apex 二选一）
# 启用 Google 登录：Supabase Dashboard → Authentication → Providers 开启 Google；URL Configuration → Redirect URLs 添加 https://你的域名/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3078

# Database Configuration (if using direct database connection)
# DATABASE_URL=postgresql://username:password@localhost:5432/domain_financial

# Development Configuration
NODE_ENV=development
PORT=3078

# Security (for production)
# 不要设 JWT_SECRET。项目现在用的是 Supabase 的 HS256 共享密钥，那把密钥能
# 为任意用户签发令牌 —— 把它放进环境变量等于给一次 env 泄漏配上主钥匙，而
# 代码里没有任何地方需要自己验签（API 路由走 auth-helper 的 getUser）。
# 真要省掉每请求那一次 GoTrue 往返，正路是先在 Supabase 侧迁到非对称签名
# 密钥，然后用 supabase-js 的 getClaims() 靠 JWKS 本地验签。
# 判断当前用的哪种：curl https://<project>.supabase.co/auth/v1/.well-known/jwks.json
#   {"keys":[]} = 还在 HS256（2026-09-06 实测就是这个）
#   有 keys     = 非对称，getClaims() 会本地验，不再打网络
# ENCRYPTION_KEY=your_encryption_key_here

# Email Configuration (for user notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# MIXPANEL_TOKEN=your_mixpanel_token

# File Storage (for domain screenshots, documents)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=domain-financial-storage

# Domain API Keys (for domain value estimation)
# ESTIMATED_DOMAIN_API_KEY=your_api_key
# WHOIS_API_KEY=your_whois_api_key

# Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000

# Logging
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# Docker Configuration
# Use these for Docker development
# POSTGRES_DB=domain_financial_dev
# POSTGRES_USER=domain_financial
# POSTGRES_PASSWORD=domain_financial_password
# REDIS_URL=redis://redis:6379

# Docker Compose Override
# Create docker-compose.override.yml for local customizations
# Example:
# version: '3.8'
# services:
#   domain-financial:
#     volumes:
#       - ./src:/app/src
#     environment:
#       - NODE_ENV=development
